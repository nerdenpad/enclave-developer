# Overlay for the Modal development inference endpoint; loaded by npm run dev:modal.
# Keep DATABASE_URL, REDIS_URL and local contract configuration in the regular .env.
NODE_ENV=development
TEE_MODE=dev
INFERENCE_BACKEND=openai-compatible
# Paste the deployed HTTPS URL here, with /v1 appended. No query or credentials.
INFERENCE_BASE_URL=
INFERENCE_MODEL=Qwen/Qwen2.5-3B-Instruct
INFERENCE_ALLOW_REMOTE=true
# Authenticated readiness polling handles Modal cold starts before sending a prompt.
INFERENCE_HEALTH_PATH=/health
# Same value as INFERENCE_API_KEY in the Modal Secret enclave-inference.
# Generate locally with python scripts/modal-secret.py init. Never commit this value.
INFERENCE_API_KEY=
INFERENCE_TIMEOUT_MS=300000

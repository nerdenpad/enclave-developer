# Copy to the repository root as .env.near (ignored by Git). Never commit the key.
NODE_ENV=development
TEE_MODE=dev
INFERENCE_BACKEND=near-verified
INFERENCE_BASE_URL=https://glm-5-3-flash.completions.near.ai/v1
INFERENCE_MODEL=z-ai/glm-5.3-flash
INFERENCE_ALLOW_REMOTE=true
INFERENCE_API_KEY=
INFERENCE_HEALTH_PATH=
INFERENCE_TIMEOUT_MS=120000
NEAR_MAX_TOKENS=512
# Windows path; on Linux use infra/near/.venv/bin/python.
NEAR_VERIFIER_PYTHON=infra/near/.venv/Scripts/python.exe
# Explicit development review, expires 2026-09-26. Re-review before replacing.
NEAR_ATTESTATION_POLICY=infra/near/policy.glm-2026-09-19.json

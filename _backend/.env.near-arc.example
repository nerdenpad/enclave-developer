# Copy to a private operator environment file. This template cannot start a release.
# Complete and validate the accepted manifest before switching a hosted pilot.
NODE_ENV=production
TEE_MODE=managed-near
PRODUCTION_RELEASE_MANIFEST=/opt/enclave/_backend/data/release/accepted-release.json
ENCLAVE_CVM_PATH=/opt/enclave/_backend/data/demo/cvm.json
DATABASE_URL=postgresql://REPLACE_LOCALLY
REDIS_URL=redis://127.0.0.1:6380
API_HOST=127.0.0.1
API_PORT=8787
WALLET_AUTH_ORIGIN=https://enclaveagent.tech
# Same-host Nginx must overwrite X-Real-IP with $remote_addr. Use only the
# exact proxy socket addresses; leave empty when serving the API directly.
WALLET_AUTH_TRUSTED_PROXY_IPS=127.0.0.1,::1
ARC_CHAIN_ID=5042
ARC_RPC_URL=https://rpc.mainnet.arc.io
CHAIN_CONFIRMATIONS=12
PAYMENT_MODE=authorized
ALLOW_LOCAL_BOOTSTRAP=false
USDC_ADDRESS=0x3600000000000000000000000000000000000000
USDC_EIP712_NAME=USDC
USDC_EIP712_VERSION=2
# Use the independently reviewed deployment record for all contract addresses.
ATTESTATION_VERIFIER_ADDRESS=REPLACE_LOCALLY
MODEL_REGISTRY_ADDRESS=REPLACE_LOCALLY
USAGE_METER_ADDRESS=REPLACE_LOCALLY
FEE_VAULT_ADDRESS=REPLACE_LOCALLY
ENCL_TOKEN_ADDRESS=REPLACE_LOCALLY
INSURANCE_STAKING_ADDRESS=REPLACE_LOCALLY
AGENT_MANDATE_ADDRESS=REPLACE_LOCALLY
RELAY_KEY_FILE=/opt/enclave/_backend/data/arc/relay.json
INFERENCE_BACKEND=near-verified
# Selected experimental direct route. Replace the placeholder with the reviewed
# lowercase model label and bind this exact endpoint into the accepted manifest.
NEAR_ENDPOINT_PROFILE=direct-experimental
# Retry only unapproved direct-node attestation, before inference; requires the pinned policy below.
# Range 1..3; all attempts share the original timeout. Inference POST is never retried.
NEAR_DIRECT_ADMISSION_ATTEMPTS=1
INFERENCE_BASE_URL=https://REPLACE_MODEL_LABEL.completions.near.ai/v1
# Cloud is a separate route requiring its own accepted policy/archive:
# NEAR_ENDPOINT_PROFILE=cloud
# INFERENCE_BASE_URL=https://cloud-api.near.ai/v1
INFERENCE_MODEL=z-ai/glm-5.3-flash
INFERENCE_ALLOW_REMOTE=true
INFERENCE_API_KEY=REPLACE_LOCALLY
INFERENCE_TIMEOUT_MS=180000
NEAR_VERIFIER_PYTHON=/opt/enclave/_backend/infra/near/.venv/bin/python
# NRAS and local NVAT are explicit, separately reviewed verifier profiles.
# Local mode requires pinned NVIDIA CLI/library hashes in the provider policy.
NVIDIA_VERIFIER_MODE=nras
# NVIDIA_VERIFIER_MODE=local
# NVIDIA_NVAT_BINARY=/var/lib/enclave/nvidia-local/1.2.2/bin/nvattest
# NVIDIA_NVAT_LIBRARY=/var/lib/enclave/nvidia-local/1.2.2/lib/libnvat.so.1.2.2
NEAR_ATTESTATION_POLICY=/opt/enclave/_backend/data/release/provider-policy.json
# Exact reviewed file digest, lowercase 0x-prefixed SHA-256. Direct node profiles,
# signed transcript and archived hardware evidence are required for acceptance.
NEAR_ATTESTATION_POLICY_SHA256=REPLACE_WITH_REVIEWED_FILE_SHA256
NEAR_MAX_TOKENS=512
# GLM-5.3-Flash always thinks. Keep its reasoning parser enabled and reserve
# enough generated tokens for a final answer; enable_thinking=false does not
# disable thinking in the selected pinned model chat template.
NEAR_ENABLE_THINKING=true
SERVING_IMAGE_ID=REPLACE_WITH_ACCEPTED_SERVING_IDENTITY
TCB_POLICY_VERSION=REPLACE_WITH_ACCEPTED_VERSION
INFERENCE_PRICE_USDC=REPLACE_WITH_APPROVED_PRICE
AGENT_RUNTIME_ENABLED=false

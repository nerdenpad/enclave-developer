NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
# Optional public EOA login; run db:migrate first. Never use an origin supplied by a request.
# WALLET_AUTH_ORIGIN=https://enclaveagent.tech
API_PORT=8787

DATABASE_URL=postgres://enclave:enclave@127.0.0.1:5433/enclave
REDIS_URL=redis://127.0.0.1:6379

# Local Anvil (docker compose). Pin Arc addresses from live docs before mainnet.
ARC_RPC_URL=http://127.0.0.1:8545
ARC_CHAIN_ID=31337
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# On Arc Mainnet remove DEPLOYER_PRIVATE_KEY and use a dedicated Linux signer file.
# Run scripts/provision-arc-relay.mjs as the service user, then back up the key securely.
# RELAY_KEY_FILE=/var/lib/enclave/arc-relay/signer.json
# Mainnet requires reviewed contracts and funding before enabling authorized payments.

ATTESTATION_VERIFIER_ADDRESS=
MODEL_REGISTRY_ADDRESS=
USAGE_METER_ADDRESS=
FEE_VAULT_ADDRESS=
ENCL_TOKEN_ADDRESS=
USDC_ADDRESS=
INSURANCE_STAKING_ADDRESS=
AGENT_MANDATE_ADDRESS=

# Dev TEE: software CVM. Hardware gateway deployment needs a separately provisioned CVM.
TEE_MODE=dev
SERVING_IMAGE_ID=enclave-echo-v1
TCB_POLICY_VERSION=1
INFERENCE_PRICE_USDC=0.10

# The gateway remains a software CVM. near-verified attests the remote provider only.
INFERENCE_BACKEND=echo
# OpenAI-compatible chat server. Listing must match this model ID.
INFERENCE_BASE_URL=http://127.0.0.1:8000/v1
INFERENCE_MODEL=echo
INFERENCE_TIMEOUT_MS=30000
# Non-loopback servers require explicit opt-in, HTTPS and a Bearer API key.
INFERENCE_ALLOW_REMOTE=false
INFERENCE_API_KEY=
# Optional same-origin HTTPS readiness polling for a scale-to-zero endpoint:
# INFERENCE_HEALTH_PATH=/health
# For INFERENCE_BACKEND=near-verified, copy infra/near/.env.example to .env.near.
# A Python verifier and reviewed, unexpired hardware policy are mandatory.

# mock mints test USDC; authorized consumes the payer's signed EIP-3009 authorization.
PAYMENT_MODE=mock
USDC_EIP712_NAME=USD Coin
USDC_EIP712_VERSION=2
ALLOW_LOCAL_BOOTSTRAP=false
# Default confirmation depth: 0 on local chains, 12 elsewhere.
# CHAIN_CONFIRMATIONS=12
# Set a stable deployment identifier if several catalogs share one database.
# CHAIN_DEPLOYMENT_ID=my-deployment

# Durable agent jobs. Enable explicitly; hosted development is not hardware key custody.
# Mock payments additionally require ALLOW_LOCAL_BOOTSTRAP=true and ARC_CHAIN_ID=31337.
AGENT_RUNTIME_ENABLED=false
AGENT_RUNTIME_POLL_MS=1000
AGENT_RUNTIME_MAX_STEPS=8
AGENT_RUNTIME_MAX_BUDGET_UNITS=1000000
AGENT_RUNTIME_MAX_DURATION_MS=900000

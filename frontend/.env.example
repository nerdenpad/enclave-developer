# Development proxy only; no API key or provider credential belongs in VITE_* variables.
ENCLAVE_API_URL=http://127.0.0.1:8789

# Public project identifier; get it from the WalletConnect/Reown dashboard.
# Allow enclaveagent.tech and the required local development origins there.
# Empty: browser extensions work; remote pairing and the directory stay unavailable.
VITE_WALLETCONNECT_PROJECT_ID=

# Leave disabled until tariff, deployed contracts and paid acceptance are approved.
# Addresses are independently reviewed pins, never inferred from a payment challenge.
VITE_ARC_PAYMENTS_ENABLED=false
VITE_ARC_USAGE_METER=
VITE_ARC_VERIFIER=
VITE_ARC_RECEIPT_SIGNER=
# Maximum per-payment amount in six-decimal ERC-20 USDC units.
VITE_ARC_MAX_PAYMENT_UNITS=
